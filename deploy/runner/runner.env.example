INCIDENT_RUNNER_BIND=127.0.0.1:8787
INCIDENT_RUNNER_TOKEN=replace-with-at-least-32-random-characters
INCIDENT_BINARY_DIR=/opt/ebpf-incident-lab/bin
INCIDENT_FIXTURE_DIR=/opt/ebpf-incident-lab/bin
INCIDENT_DB_PATH=/var/lib/ebpf-incident-lab/incident-lab.sqlite3
INCIDENT_HASH_SALT=replace-with-independent-random-salt
INCIDENT_DISABLE_SESSIONS=false
RUST_LOG=incident_web_runner=info,tower_http=info
