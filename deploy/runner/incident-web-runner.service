[Unit]
Description=eBPF Incident Lab fixed-operation runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/ebpf-incident-lab/runner.env
ExecStart=/opt/ebpf-incident-lab/bin/incident-web-runner
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
WorkingDirectory=/var/lib/ebpf-incident-lab
StateDirectory=ebpf-incident-lab
RuntimeDirectory=ebpf-incident-lab
UMask=0077
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ebpf-incident-lab /run/ebpf-incident-lab
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
LimitNOFILE=1024
MemoryMax=1G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
